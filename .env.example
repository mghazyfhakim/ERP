# Nexus ERP Suite — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# SQLite (dev default) — switch to PostgreSQL URL for production, e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/nexus_erp?schema=public"
DATABASE_URL=file:/home/z/my-project/db/custom.db

# NextAuth (add when auth phase is implemented)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-with: openssl rand -base64 32

# Payment gateway (add when billing phase is implemented)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=

# Realtime service port (socket.io mini-service)
# REALTIME_PORT=3003
